# Enforce LF line endings in the repository
# This keeps files consistent across platforms and avoids CRLF warnings
* text=auto eol=lf

# Treat binary files as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binaryattached_assets/Creative-Render-Studio_1778099747485.zip filter=lfs diff=lfs merge=lfs -text
