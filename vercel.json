{
  "builds": [
    {
      "src": "artifacts/heartloom/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "corepack pnpm install --frozen-lockfile && corepack pnpm build",
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/heartloom/dist/public/index.html"
    }
  ]
}