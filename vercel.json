{
  "buildCommand": "corepack pnpm --filter @workspace/heartloom build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/heartloom/dist/public/index.html"
    }
  ]
}